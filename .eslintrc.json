{
    "extends": "airbnb-base",
    "env": {
        "node": true
    },
    "rules": {
        "indent": [2, 4],
        "comma-dangle": "off"
    },
    "overrides": [
        {
            "files": [
                "handlers/**/*.js",
                "lib/**/*.js",
                "schema.js"
            ],
            "parserOptions": {
                "sourceType": "module"
            },
            "rules": {
                "import/no-unresolved": "off",
                "import/prefer-default-export": "off",
                "no-console": "off"
            }
        }
    ]
}
